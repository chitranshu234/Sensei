# AI Service Environment Variables
# Copy this to .env and fill in your API key

# Google Gemini API Key (required only when LLM_PROVIDER=google or EMBEDDING_PROVIDER=google)
GOOGLE_API_KEY=your-gemini-api-key-here

# Embedding provider: google is best for memory-constrained Render deployments. Set to `local`
# for an offline local workspace after the MiniLM model has been downloaded.
EMBEDDING_PROVIDER=google

# Local embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Keep local workspaces offline after the model has been downloaded. Set false once on a new
# machine to allow the initial Hugging Face download, then set it back to true.
EMBEDDING_LOCAL_FILES_ONLY=true

# Google embedding model (only used with EMBEDDING_PROVIDER=google)
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# LLM settings
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
